<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EVO · Absen Karyawan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        /* ===== SAME STYLES ===== */
        * { margin:0; padding:0; box-sizing:border-box; }
        :root {
            --bg-primary: #0b0b1a;
            --bg-secondary: #111128;
            --bg-card: rgba(255,255,255,0.04);
            --bg-card-hover: rgba(255,255,255,0.07);
            --border-glass: rgba(255,255,255,0.08);
            --text-primary: #f0f0f8;
            --text-secondary: #a8a8c8;
            --text-muted: #6a6a8a;
            --gold: #e4a853;
            --gold-light: #f5d08a;
            --gold-glow: rgba(228,168,83,0.25);
            --shadow-card: 0 20px 50px rgba(0,0,0,0.6);
            --radius: 20px;
            --radius-sm: 12px;
            --transition: 0.35s cubic-bezier(0.25,0.46,0.45,0.94);
        }
        body { font-family:'Inter',sans-serif; background:var(--bg-primary); color:var(--text-primary); min-height:100vh; padding:24px 16px 60px; background-image:radial-gradient(ellipse at 20% 10%, rgba(228,168,83,0.06) 0%, transparent 60%), radial-gradient(ellipse at 80% 90%, rgba(228,168,83,0.04) 0%, transparent 50%); }
        .app-wrapper { max-width:1300px; margin:0 auto; }
        .app-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; padding:18px 28px; background:var(--bg-card); backdrop-filter:blur(24px); border:1px solid var(--border-glass); border-radius:var(--radius); margin-bottom:32px; box-shadow:var(--shadow-card); }
        .brand { display:flex; align-items:center; gap:14px; }
        .brand .logo-svg { width:44px; height:44px; filter:drop-shadow(0 0 12px var(--gold-glow)); }
        .brand h1 { font-size:24px; font-weight:700; background:linear-gradient(135deg,#fff 30%,var(--gold-light) 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
        .brand h1 span { font-weight:400; opacity:0.5; -webkit-text-fill-color:var(--text-secondary); }
        .header-actions { display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
        .upload-btn-wrapper { position:relative; overflow:hidden; display:inline-block; }
        .upload-btn-wrapper input[type=file] { position:absolute; left:0; top:0; opacity:0; width:100%; height:100%; cursor:pointer; }
        .btn { display:inline-flex; align-items:center; gap:10px; padding:10px 22px; border-radius:60px; font-weight:600; font-size:14px; border:none; cursor:pointer; transition:var(--transition); font-family:inherit; background:rgba(255,255,255,0.06); color:var(--text-primary); border:1px solid var(--border-glass); }
        .btn i { font-size:16px; }
        .btn:hover { transform:translateY(-2px); box-shadow:0 8px 30px rgba(0,0,0,0.4); }
        .btn-gold { background:linear-gradient(135deg,var(--gold),#c9923a); color:#0b0b1a; border-color:var(--gold); box-shadow:0 4px 20px var(--gold-glow); }
        .btn-gold:hover { box-shadow:0 8px 35px var(--gold-glow); background:linear-gradient(135deg,#f5d08a,var(--gold)); }
        .btn-outline { background:transparent; border-color:rgba(255,255,255,0.15); }
        .btn-outline:hover { background:rgba(255,255,255,0.05); border-color:rgba(255,255,255,0.25); }
        .btn-sm { padding:6px 14px; font-size:12px; }
        .btn:disabled { opacity:0.4; cursor:not-allowed; transform:none !important; box-shadow:none !important; }
        .btn-danger { color:#f87171; border-color:rgba(248,113,113,0.2); }
        .btn-danger:hover { background:rgba(248,113,113,0.1); border-color:rgba(248,113,113,0.3); }
        .card { background:var(--bg-card); backdrop-filter:blur(20px); border:1px solid var(--border-glass); border-radius:var(--radius); padding:24px 28px 30px; box-shadow:var(--shadow-card); transition:var(--transition); margin-bottom:28px; }
        .card:hover { background:var(--bg-card-hover); border-color:rgba(255,255,255,0.12); }
        .card-header { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
        .card-header i { font-size:22px; color:var(--gold); width:28px; text-align:center; }
        .card-header h2 { font-size:18px; font-weight:600; }
        .card-header .badge { margin-left:auto; background:var(--gold-glow); color:var(--gold-light); font-size:11px; font-weight:600; padding:4px 14px; border-radius:40px; border:1px solid rgba(228,168,83,0.2); }
        .table-wrap { overflow-x:auto; border-radius:var(--radius-sm); border:1px solid var(--border-glass); }
        table { width:100%; border-collapse:collapse; font-size:14px; min-width:600px; }
        table th { text-align:left; padding:12px 16px; font-weight:600; color:var(--text-secondary); background:rgba(255,255,255,0.03); border-bottom:1px solid var(--border-glass); font-size:12px; text-transform:uppercase; letter-spacing:0.5px; position:sticky; top:0; background:var(--bg-primary); z-index:2; }
        table td { padding:10px 16px; border-bottom:1px solid rgba(255,255,255,0.04); color:var(--text-secondary); vertical-align:middle; }
        table tr:last-child td { border-bottom:none; }
        table tr:hover td { background:rgba(255,255,255,0.02); }
        table td select { background:rgba(255,255,255,0.06); border:1px solid var(--border-glass); border-radius:6px; color:var(--text-primary); padding:4px 8px; font-family:inherit; font-size:13px; cursor:pointer; outline:none; transition:var(--transition); width:100%; min-width:80px; }
        table td select:focus { border-color:var(--gold); box-shadow:0 0 0 3px var(--gold-glow); }
        table td select:disabled { opacity:0.5; cursor:not-allowed; }
        table td select option { background:var(--bg-secondary); color:var(--text-primary); }
        .status-badge { display:inline-block; padding:2px 12px; border-radius:40px; font-size:12px; font-weight:600; }
        .status-hadir { background:rgba(74,222,128,0.15); color:#4ade80; }
        .status-absen { background:rgba(248,113,113,0.15); color:#f87171; }
        .status-libur { background:rgba(250,204,21,0.15); color:#facc15; }
        .status-kosong { background:rgba(255,255,255,0.04); color:var(--text-muted); }
        .rekap-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); gap:16px; margin-top:20px; }
        .rekap-item { background:rgba(255,255,255,0.03); border-radius:var(--radius-sm); padding:14px 18px; border:1px solid var(--border-glass); text-align:center; }
        .rekap-item .name { font-weight:600; color:var(--text-primary); }
        .rekap-item .hadir { font-size:20px; font-weight:700; color:#4ade80; }
        .rekap-item .gaji { font-size:16px; color:var(--gold); font-weight:600; }
        .rekap-item .detail { font-size:13px; color:var(--text-muted); margin-top:4px; }
        .text-muted { color:var(--text-muted); }
        .text-center { text-align:center; }
        .mt-2 { margin-top:12px; }
        .flex { display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
        .gap-1 { gap:8px; }
        .toast-container { position:fixed; bottom:30px; right:30px; z-index:9999; display:flex; flex-direction:column; gap:10px; max-width:360px; width:100%; }
        .toast { padding:14px 20px; border-radius:var(--radius-sm); background:var(--bg-secondary); border:1px solid var(--border-glass); backdrop-filter:blur(20px); color:var(--text-primary); font-size:14px; font-weight:500; box-shadow:0 12px 40px rgba(0,0,0,0.6); animation:slideUp 0.4s ease forwards; display:flex; align-items:center; gap:12px; }
        .toast i { font-size:18px; color:var(--gold); }
        .toast.success i { color:#4ade80; }
        .toast.error i { color:#f87171; }
        .toast.hide { animation:slideDown 0.3s ease forwards; }
        @keyframes slideUp { from { opacity:0; transform:translateY(30px) scale(0.96); } to { opacity:1; transform:translateY(0) scale(1); } }
        @keyframes slideDown { from { opacity:1; transform:translateY(0) scale(1); } to { opacity:0; transform:translateY(30px) scale(0.96); } }
        .logo-svg svg { display:block; width:100%; height:100%; }
        ::-webkit-scrollbar { width:6px; height:6px; }
        ::-webkit-scrollbar-track { background:var(--bg-primary); }
        ::-webkit-scrollbar-thumb { background:var(--gold); border-radius:10px; }
        .btn-reset { color:var(--text-muted); border-color:rgba(255,255,255,0.06); }
        .btn-reset:hover { color:#f87171; border-color:rgba(248,113,113,0.2); background:rgba(248,113,113,0.05); }
        @media (max-width:768px) { .app-header { flex-direction:column; align-items:stretch; } .brand h1 { font-size:20px; } .card { padding:16px; } table td select { min-width:60px; font-size:12px; } .rekap-grid { grid-template-columns:1fr 1fr; } }
        @media (max-width:480px) { .rekap-grid { grid-template-columns:1fr; } }
        .db-status { font-size:12px; color:var(--text-muted); background:rgba(255,255,255,0.04); padding:4px 12px; border-radius:40px; border:1px solid var(--border-glass); }
        .role-selector { display:flex; align-items:center; gap:8px; background:rgba(255,255,255,0.04); padding:4px 12px 4px 16px; border-radius:40px; border:1px solid var(--border-glass); }
        .role-selector label { font-size:13px; color:var(--text-secondary); }
        .role-selector select { background:transparent; border:none; color:var(--text-primary); font-weight:600; font-size:14px; padding:6px 4px; outline:none; cursor:pointer; font-family:inherit; }
        .role-selector select option { background:var(--bg-secondary); color:var(--text-primary); }
        .role-badge { font-size:11px; font-weight:600; padding:2px 12px; border-radius:40px; text-transform:uppercase; }
        .role-admin { background:rgba(228,168,83,0.2); color:var(--gold); border:1px solid rgba(228,168,83,0.2); }
        .role-karyawan { background:rgba(74,222,128,0.15); color:#4ade80; border:1px solid rgba(74,222,128,0.15); }
        .btn-logout { color:var(--text-muted); border-color:rgba(255,255,255,0.06); }
        .btn-logout:hover { color:#f87171; border-color:rgba(248,113,113,0.2); background:rgba(248,113,113,0.05); }
    </style>
</head>
<body>

    <!-- ===== LOGIN PAGE ===== -->
    <div id="loginPage">
        <div class="login-card">
            <div class="logo">
                <svg viewBox="0 0 100 100" fill="none" width="72" height="72">
                    <circle cx="50" cy="50" r="46" stroke="url(#goldGrad)" stroke-width="3" fill="rgba(228,168,83,0.06)"/>
                    <text x="50" y="62" font-family="Inter, sans-serif" font-size="40" font-weight="700" fill="url(#goldGrad)" text-anchor="middle" letter-spacing="2">EVO</text>
                    <defs><linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#e4a853"/><stop offset="100%" stop-color="#f5d08a"/></linearGradient></defs>
                </svg>
            </div>
            <h1>Selamat Datang</h1>
            <p>Silakan login untuk mengakses absen harian</p>
            <form id="loginForm">
                <div class="form-group">
                    <label><i class="fas fa-user"></i> Username</label>
                    <input type="text" id="loginUsername" placeholder="admin atau karyawan" required />
                </div>
                <div class="form-group">
                    <label><i class="fas fa-lock"></i> Password</label>
                    <input type="password" id="loginPassword" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn-login"><i class="fas fa-sign-in-alt"></i> Masuk</button>
                <div class="login-error" id="loginError"></div>
            </form>
            <div class="login-footer">
                Demo: <span>admin</span> / <span>admin123</span> &bull; <span>karyawan</span> / <span>karyawan123</span>
            </div>
        </div>
    </div>

    <!-- ===== APP WRAPPER ===== -->
    <div id="app">
        <!-- HEADER -->
        <header class="app-header">
            <div class="brand">
                <div class="logo-svg">
                    <svg viewBox="0 0 100 100" fill="none">
                        <circle cx="50" cy="50" r="46" stroke="url(#goldGrad)" stroke-width="3" fill="rgba(228,168,83,0.06)"/>
                        <text x="50" y="62" font-family="Inter, sans-serif" font-size="40" font-weight="700" fill="url(#goldGrad)" text-anchor="middle" letter-spacing="2">EVO</text>
                        <defs><linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#e4a853"/><stop offset="100%" stop-color="#f5d08a"/></linearGradient></defs>
                    </svg>
                </div>
                <h1>EVO <span>· Absen Karyawan</span></h1>
            </div>
            <div class="header-actions">
                <span class="role-badge role-admin" id="headerRoleBadge">Admin</span>
                <span class="db-status" id="dbStatus"><i class="fas fa-database"></i> IndexedDB</span>
                <button class="btn btn-gold btn-sm" id="addEmployeeBtn"><i class="fas fa-user-plus"></i> Tambah Karyawan</button>
                <button class="btn btn-danger btn-sm" id="deleteEmployeeBtn"><i class="fas fa-user-minus"></i> Hapus Karyawan</button>
                <div class="upload-btn-wrapper" id="uploadWrapper">
                    <button class="btn btn-gold btn-sm" id="uploadBtn"><i class="fas fa-upload"></i> Upload Excel</button>
                    <input type="file" id="fileInput" accept=".xlsx,.xls" />
                </div>
                <button class="btn btn-gold btn-sm" id="exportBtn"><i class="fas fa-file-excel"></i> Export Excel</button>
                <button class="btn btn-outline btn-sm" id="resetDataBtn"><i class="fas fa-undo-alt"></i> Reset</button>
                <button class="btn btn-outline btn-sm btn-logout" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> Logout</button>
                <span class="text-muted" style="font-size:13px;" id="lastUpdate"></span>
            </div>
        </header>

        <!-- CARD TABEL ABSEN -->
        <section class="card">
            <div class="card-header">
                <i class="fas fa-table"></i>
                <h2>Daftar Absen Harian</h2>
                <span class="badge" id="rowCount">0</span>
            </div>
            <div class="table-wrap" id="tableWrap">
                <table>
                    <thead id="tableHead"><tr><th>Tanggal</th></tr></thead>
                    <tbody id="tableBody"><tr><td class="text-center text-muted" style="padding:30px;">Memuat data...</td></tr></tbody>
                </table>
            </div>
            <div class="flex mt-2">
                <button class="btn btn-gold btn-sm" id="addRowBtn"><i class="fas fa-plus"></i> Tambah Tanggal</button>
                <span class="text-muted" style="font-size:13px;">Klik dropdown untuk mengubah status</span>
            </div>
        </section>

        <!-- REKAP & GAJI -->
        <section class="card">
            <div class="card-header">
                <i class="fas fa-chart-simple"></i>
                <h2>Rekap Hadir &amp; Gaji</h2>
                <span class="badge" id="rekapCount">0</span>
            </div>
            <div id="rekapContainer">
                <div class="rekap-grid" id="rekapGrid"><div class="text-muted" style="padding:20px;text-align:center;">Memuat...</div></div>
                <div style="margin-top:16px; font-size:14px; color:var(--text-muted);">
                    <i class="fas fa-info-circle"></i> Gaji per hari: <strong id="salaryDisplay" style="color:var(--gold);">Rp50.000</strong>
                    <button class="btn btn-outline btn-sm" id="editSalaryBtn" style="margin-left:12px;"><i class="fas fa-pen"></i> Ubah</button>
                </div>
