<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wondr by BNI - Mockup</title>
    <!-- Menggunakan FontAwesome untuk ikon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --wondr-orange: #FF6600;
            --wondr-teal-light: #A0E8DC;
            --wondr-teal-dark: #009688;
            --wondr-lime: #D4F34A;
            --bg-gray: #F8F9FA;
            --text-dark: #1A1A1A;
            --text-gray: #888888;
            --card-orange-start: #FF8C42;
            --card-orange-end: #FF6B00;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px 0;
        }

        /* Kontainer Utama yang menyerupai layar HP */
        .mobile-container {
            width: 100%;
            max-width: 400px;
            height: 850px;
            background-color: #fff;
            border-radius: 30px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
        }

        /* Navigasi Demo (untuk beralih halaman) */
        .demo-nav {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 9999;
            display: flex;
            gap: 5px;
        }
        .demo-nav button {
            padding: 5px 10px;
            font-size: 10px;
            border: none;
            border-radius: 10px;
            background: #333;
            color: #fff;
            cursor: pointer;
            opacity: 0.5;
        }
        .demo-nav button:hover {
            opacity: 1;
        }

        /* ================= PAGE: LOGIN ================= */
        #login-page {
            display: none;
            flex-direction: column;
            height: 100%;
            width: 100%;
            background-color: #E0F2F1;
            position: relative;
        }
        #login-page.active {
            display: flex;
        }

        .promo-banner {
            background-color: #5BC0BE;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
            padding: 20px;
            position: relative;
            color: #fff;
            height: 180px;
            overflow: hidden;
        }

        .promo-date {
            background: rgba(255,255,255,0.2);
            display: inline-block;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 10px;
            margin-bottom: 10px;
        }

        .promo-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 5px;
            width: 60%;
        }

        .promo-sub {
            font-size: 10px;
            opacity: 0.8;
        }

        .promo-img {
            position: absolute;
            right: -20px;
            bottom: -10px;
            width: 150px;
            height: 150px;
            background: url('https://placehold.co/150x150/transparent/transparent') no-repeat center;
            /* Placeholder untuk gambar ilustrasi */
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 60px;
        }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 5px;
            margin-top: 15px;
        }

        .dot {
            width: 6px;
            height: 6px;
            background: #ccc;
            border-radius: 50%;
        }
        .dot.active {
            background: #333;
        }

        .login-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            padding: 20px;
        }

        .illustration-bg {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 60%;
            background: linear-gradient(180deg, transparent, #A0E8DC);
            z-index: 0;
            border-top-left-radius: 50% 20px;
            border-top-right-radius: 50% 20px;
        }

        .wondr-logo {
            font-size: 32px;
            font-weight: 800;
            color: var(--wondr-orange);
            margin-bottom: 40px;
            z-index: 1;
        }
        .wondr-logo span {
            font-size: 12px;
            color: #666;
            font-weight: 400;
            display: block;
            text-align: right;
            margin-top: -5px;
        }

        .quick-actions {
            display: flex;
            gap: 20px;
            margin-bottom: 40px;
            z-index: 1;
        }

        .action-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 600;
        }

        .action-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            color: #333;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .action-icon.ewallet { background-color: var(--wondr-teal-light); }
        .action-icon.qris { background-color: #FFD54F; }
        .action-icon.tapcash { background-color: var(--wondr-orange); color: white; }

        .btn-login {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 30px;
            background-color: var(--wondr-teal-dark);
            color: white;
            font-size: 16px;
            font-weight: 600;
            z-index: 1;
            cursor: pointer;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,150,136,0.3);
        }

        .version-text {
            font-size: 12px;
            color: #888;
            z-index: 1;
        }

        /* ================= PAGE: DASHBOARD ================= */
        #dashboard-page {
            display: none;
            flex-direction: column;
            height: 100%;
            width: 100%;
            background-color: var(--bg-gray);
            overflow-y: auto;
            position: relative;
            padding-bottom: 80px; /* Ruang untuk tombol QRIS */
        }
        #dashboard-page.active {
            display: flex;
        }

        /* Header */
        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background-color: #fff;
        }

        .app-logo {
            font-size: 24px;
            font-weight: 800;
            color: var(--wondr-orange);
        }
        .app-logo span {
            font-size: 10px;
            color: #888;
            font-weight: 400;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 6px 12px;
            border: 1px solid #ddd;
            border-radius: 20px;
            background: #fff;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-dark);
        }

        /* Greeting */
        .greeting-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
            background-color: #fff;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #ddd;
            background-image: url('https://i.pravatar.cc/150?img=5');
            background-size: cover;
        }

        .greeting-text {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .header-icons {
            display: flex;
            gap: 15px;
            font-size: 18px;
            color: var(--text-dark);
        }

        .notification-dot {
            position: relative;
        }
        .notification-dot::after {
            content: '';
            position: absolute;
            top: -2px;
            right: -2px;
            width: 8px;
            height: 8px;
            background-color: var(--wondr-orange);
            border-radius: 50%;
            border: 2px solid #fff;
        }

        /* Tabs */
        .tabs-container {
            display: flex;
            background-color: #fff;
            padding: 10px 20px 20px;
            gap: 10px;
        }

        .tab {
            flex: 1;
            text-align: center;
            padding: 10px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-gray);
            background-color: transparent;
            cursor: pointer;
        }

        .tab.active {
            background-color: var(--wondr-lime);
            color: var(--text-dark);
        }

        /* Sections */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 20px 10px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .section-link {
            font-size: 12px;
            font-weight: 600;
            color: var(--wondr-orange);
            text-decoration: underline;
        }

        /* Cards Carousel */
        .cards-container {
            display: flex;
            gap: 15px;
            padding: 0 20px;
            overflow-x: auto;
            scrollbar-width: none; /* Firefox */
        }
        .cards-container::-webkit-scrollbar {
            display: none; /* Chrome */
        }

        .card-asset {
            min-width: 100px;
            height: 160px;
            background-color: var(--wondr-teal-light);
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
        }

        .card-asset i {
            font-size: 24px;
            background: white;
            padding: 10px;
            border-radius: 50%;
        }

        .card-account {
            min-width: 250px;
            height: 160px;
            background: linear-gradient(135deg, var(--card-orange-start), var(--card-orange-end));
            border-radius: 15px;
            padding: 20px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        /* Efek gelombang pada kartu orange */
        .card-account::after {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
        }

        .card-type {
            font-size: 12px;
            opacity: 0.9;
        }

        .card-number {
            font-size: 16px;
            font-weight: 700;
            margin-top: 2px;
        }

        .card-balance-label {
            font-size: 12px;
            opacity: 0.9;
            margin-top: 15px;
        }

        .card-balance {
            font-size: 22px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: white;
            color: var(--text-dark);
            font-size: 10px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 10px;
        }

        /* Menu Grid */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            padding: 10px 20px;
        }

        .menu-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            text-align: center;
        }

        .menu-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            color: var(--text-dark);
        }

        .menu-icon.teal { background-color: var(--wondr-teal-light); }
        .menu-icon.orange { background-color: var(--wondr-orange); color: white; }
        .menu-icon.blue { background-color: #A0C4FF; }

        .menu-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-dark);
        }

        /* Recent Transactions */
        .transaction-list {
            padding: 0 20px;
        }

        .transaction-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }

        .transaction-icon {
            width: 40px;
            height: 40px;
            background-color: var(--wondr-teal-light);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--wondr-teal-dark);
        }

        .transaction-details {
            flex: 1;
        }

        .transaction-title {
            font-size: 12px;
            color: var(--text-gray);
        }

        .transaction-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
        }

        /* Floating QRIS Button */
        .floating-qris {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background-color: #1A1A1A;
            color: white;
            padding: 12px 40px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 16px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 100;
            border: none;
            cursor: pointer;
        }

    </style>
</head>
<body>

    <!-- Navigasi Demo -->
    <div class="demo-nav">
        <button onclick="showPage('login')">Login</button>
        <button onclick="showPage('dashboard')">Dashboard</button>
    </div>

    <div class="mobile-container">
        
        <!-- ================= HALAMAN LOGIN ================= -->
        <div id="login-page" class="active">
            <!-- Promo Banner -->
            <div class="promo-banner">
                <div class="promo-date">26 Feb - 6 Apr 2025</div>
                <div class="promo-title">Cashback hingga Rp200 Ribu Tiket KAI</div>
                <div class="promo-sub">dengan wondr by BNI</div>
                <!-- Placeholder untuk gambar ilustrasi promo -->
                <div class="promo-img">🧑‍💼📱</div>
            </div>

            <!-- Pagination Dots -->
            <div class="pagination">
                <div class="dot active"></div>
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
            </div>

            <!-- Konten Login -->
            <div class="login-content">
                <div class="illustration-bg"></div>
                
                <div class="wondr-logo">
                    wondr
                    <span>by BNI</span>
                </div>

                <div class="quick-actions">
                    <div class="action-item">
                        <div class="action-icon ewallet"><i class="fas fa-wallet"></i></div>
                        <span>E-Wallet</span>
                    </div>
                    <div class="action-item">
                        <div class="action-icon qris"><i class="fas fa-qrcode"></i></div>
                        <span>QRIS</span>
                    </div>
                    <div class="action-item">
                        <div class="action-icon tapcash"><i class="fas fa-credit-card"></i></div>
                        <span>TapCash</span>
                    </div>
                </div>

                <button class="btn-login">Login</button>
                <div class="version-text">1.3.1</div>
            </div>
        </div>

        <!-- ================= HALAMAN DASHBOARD ================= -->
        <div id="dashboard-page">
            <!-- Header -->
            <div class="app-header">
                <div class="app-logo">
                    wondr <span>by BNI</span>
                </div>
                <button class="btn-logout">
                    <i class="fas fa-sign-out-alt"></i> Keluar
                </button>
            </div>

            <!-- Greeting -->
            <div class="greeting-section">
                <div class="user-info">
                    <div class="avatar"></div>
                    <div class="greeting-text">Hai, Karnisa!</div>
                </div>
                <div class="header-icons">
                    <i class="fas fa-bell notification-dot"></i>
                    <i class="fas fa-comment-alt"></i>
                    <i class="fas fa-th-large"></i>
                </div>
            </div>

            <!-- Tabs -->
            <div class="tabs-container">
                <div class="tab">Insights</div>
                <div class="tab active">Transaksi</div>
                <div class="tab">Growth</div>
            </div>

            <!-- Rekening Transaksi -->
            <div class="section-header">
                <div class="section-title">Rekening transaksi kamu</div>
                <div class="section-link">Lihat semua</div>
            </div>

            <div class="cards-container">
                <div class="card-asset">
                    <i class="fas fa-chart-pie"></i>
                    <span>Lihat<br>Aset</span>
                </div>
                <div class="card-account">
                    <div>
                        <div class="card-badge">UTAMA</div>
                        <div class="card-type">BNI Taplus</div>
                        <div class="card-number">0223383830</div>
                    </div>
                    <div>
                        <div class="card-balance-label">Total saldo</div>
                        <div class="card-balance">
                            Rp2.800.000.000 <i class="fas fa-eye-slash" style="font-size: 14px;"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fitur Pilihan -->
            <div class="section-header">
                <div class="section-title">Fitur pilihan kamu</div>
                <div class="section-link">Atur</div>
            </div>

            <div class="menu-grid">
                <div class="menu-item">
                    <div class="menu-icon teal"><i class="fas fa-paper-plane"></i></div>
                    <span class="menu-label">Transfer</span>
                </div>
                <div class="menu-item">
                    <div class="menu-icon orange" style="font-size: 12px; font-weight: bold;">TapCash</div>
                    <span class="menu-label">Tapcash</span>
                </div>
                <div class="menu-item">
                    <div class="menu-icon blue"><i class="fas fa-file-invoice"></i></div>
                    <span class="menu-label">Bayar & Beli</span>
                </div>
                <div class="menu-item">
                    <div class="menu-icon teal"><i class="fas fa-arrow-right-arrow-left"></i></div>
                    <span class="menu-label">E-Wallet</span>
                </div>
                <div class="menu-item">
                    <div class="menu-icon teal" style="font-size: 14px; font-weight: bold;">VA+</div>
                    <span class="menu-label">Virtual Account</span>
                </div>
                <div class="menu-item">
                    <div class="menu-icon teal"><i class="fas fa-globe"></i></div>
                    <span class="menu-label">Transfer Luar Negeri</span>
                </div>
            </div>

            <!-- Transaksi Terakhir -->
            <div class="section-header">
                <div class="section-title">Transaksi favorit terakhir</div>
            </div>

            <div class="transaction-list">
                <div class="transaction-item">
                    <div class="transaction-icon"><i class="fas fa-paper-plane"></i></div>
                    <div class="transaction-details">
                        <div class="transaction-title">Transfer</div>
                        <div class="transaction-name">Yogie</div>
                    </div>
                    <i class="fas fa-chevron-right" style="color: #ccc;"></i>
                </div>
                <div class="transaction-item">
                    <div class="transaction-icon"><i class="fas fa-paper-plane"></i></div>
                    <div class="transaction-details">
                        <div class="transaction-title">Transfer</div>
                        <div class="transaction-name">Budi</div>
                    </div>
                    <i class="fas fa-chevron-right" style="color: #ccc;"></i>
                </div>
            </div>

            <!-- Floating Button -->
            <button class="floating-qris">QRIS</button>
        </div>

    </div>

    <!-- Script untuk Navigasi Demo -->
    <script>
        function showPage(pageId) {
            // Sembunyikan semua halaman
            document.getElementById('login-page').classList.remove('active');
            document.getElementById('dashboard-page').classList.remove('active');
            
            // Tampilkan halaman yang dipilih
            document.getElementById(pageId + '-page').classList.add('active');
        }
    </script>
</body>
</html>
