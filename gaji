        </section>
    </div>

    <!-- TOAST -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ============================================================ -->
    <!-- ===== JAVASCRIPT ===== -->
    <script>
        (function() {
            'use strict';

            // =============================================================
            // 1. AUTHENTICATION
            // =============================================================
            const CREDENTIALS = {
                admin: { password: 'admin123', role: 'admin' },
                karyawan: { password: 'karyawan123', role: 'karyawan' }
            };

            const loginPage = document.getElementById('loginPage');
            const app = document.getElementById('app');
            const loginForm = document.getElementById('loginForm');
            const loginUsername = document.getElementById('loginUsername');
            const loginPassword = document.getElementById('loginPassword');
            const loginError = document.getElementById('loginError');
            const logoutBtn = document.getElementById('logoutBtn');
            const headerRoleBadge = document.getElementById('headerRoleBadge');

            function checkAuth() {
                const loggedIn = localStorage.getItem('evo_logged_in') === 'true';
                const role = localStorage.getItem('evo_role') || 'karyawan';
                if (loggedIn) {
                    loginPage.style.display = 'none';
                    app.classList.add('active');
                    headerRoleBadge.textContent = role === 'admin' ? 'Admin' : 'Karyawan';
                    headerRoleBadge.className = 'role-badge ' + (role === 'admin' ? 'role-admin' : 'role-karyawan');
                    window.currentRole = role;
                    if (typeof initApp === 'function') {
                        initApp();
                    }
                } else {
                    loginPage.style.display = 'flex';
                    app.classList.remove('active');
                }
            }

            function doLogin(username, password) {
                const user = CREDENTIALS[username.toLowerCase()];
                if (user && user.password === password) {
                    localStorage.setItem('evo_logged_in', 'true');
                    localStorage.setItem('evo_role', user.role);
                    loginError.textContent = '';
                    checkAuth();
                    showToast('✅ Login berhasil sebagai ' + (user.role === 'admin' ? 'Admin' : 'Karyawan'), 'success');
                    return true;
                } else {
                    loginError.textContent = 'Username atau password salah.';
                    return false;
                }
            }

            function doLogout() {
                localStorage.removeItem('evo_logged_in');
                localStorage.removeItem('evo_role');
                checkAuth();
                showToast('👋 Anda telah logout.', 'info');
            }

            loginForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const username = loginUsername.value.trim();
                const password = loginPassword.value.trim();
                if (!username || !password) {
                    loginError.textContent = 'Harap isi username dan password.';
                    return;
                }
                doLogin(username, password);
            });

            logoutBtn.addEventListener('click', doLogout);

            // =============================================================
            // 2. DATABASE MANAGER (IndexedDB)
            // =============================================================
            class Database {
                constructor() {
                    this.dbName = 'EVOAttendanceDB';
                    this.dbVersion = 1;
                    this.db = null;
                    this.ready = false;
                }
                open() {
                    return new Promise((resolve, reject) => {
                        const request = indexedDB.open(this.dbName, this.dbVersion);
                        request.onupgradeneeded = (e) => {
                            const db = e.target.result;
                            if (!db.objectStoreNames.contains('settings')) {
                                db.createObjectStore('settings', { keyPath: 'id' });
                            }
                            if (!db.objectStoreNames.contains('employees')) {
                                db.createObjectStore('employees', { keyPath: 'name' });
                            }
                            if (!db.objectStoreNames.contains('attendance')) {
                                const store = db.createObjectStore('attendance', { keyPath: 'id' });
                                store.createIndex('date', 'date', { unique: false });
                            }
                        };
                        request.onsuccess = (e) => {
                            this.db = e.target.result;
                            this.ready = true;
                            resolve(this.db);
                        };
                        request.onerror = (e) => reject(e.target.error);
                    });
                }
                async getSettings() {
                    const tx = this.db.transaction('settings', 'readonly');
                    const store = tx.objectStore('settings');
                    return new Promise((resolve) => {
                        const req = store.get('main');
                        req.onsuccess = () => resolve(req.result || null);
                        req.onerror = () => resolve(null);
                    });
                }
                async saveSettings(settings) {
                    const tx = this.db.transaction('settings', 'readwrite');
                    const store = tx.objectStore('settings');
                    store.put({ id: 'main', ...settings });
                    return new Promise((resolve) => { tx.oncomplete = () => resolve(); tx.onerror = () => resolve(); });
                }
                async getEmployees() {
                    const tx = this.db.transaction('employees', 'readonly');
                    const store = tx.objectStore('employees');
                    return new Promise((resolve) => {
                        const req = store.getAll();
                        req.onsuccess = () => resolve(req.result.map(r => r.name));
                        req.onerror = () => resolve([]);
                    });
                }
                async saveEmployees(empNames) {
                    const tx = this.db.transaction('employees', 'readwrite');
                    const store = tx.objectStore('employees');
                    store.clear();
                    empNames.forEach(name => store.put({ name }));
                    return new Promise((resolve) => { tx.oncomplete = () => resolve(); tx.onerror = () => resolve(); });
                }
                async getAttendance() {
                    const tx = this.db.transaction('attendance', 'readonly');
                    const store = tx.objectStore('attendance');
                    return new Promise((resolve) => {
                        const req = store.getAll();
                        req.onsuccess = () => {
                            const all = req.result || [];
                            const map = {};
                            all.forEach(item => { map[item.date] = item.records || {}; });
                            resolve(map);
                        };
                        req.onerror = () => resolve({});
                    });
                }
                async saveAttendanceRecord(date, records) {
                    const tx = this.db.transaction('attendance', 'readwrite');
                    const store = tx.objectStore('attendance');
                    store.put({ id: date, date: date, records: records });
                    return new Promise((resolve) => { tx.oncomplete = () => resolve(); tx.onerror = () => resolve(); });
                }
                async deleteAttendanceRecord(date) {
                    const tx = this.db.transaction('attendance', 'readwrite');
                    const store = tx.objectStore('attendance');
                    store.delete(date);
                    return new Promise((resolve) => { tx.oncomplete = () => resolve(); tx.onerror = () => resolve(); });
                }
                async importAttendance(attMap) {
                    const tx = this.db.transaction('attendance', 'readwrite');
                    const store = tx.objectStore('attendance');
                    store.clear();
                    for (const [date, records] of Object.entries(attMap)) {
                        store.put({ id: date, date: date, records: records });
                    }
                    return new Promise((resolve) => { tx.oncomplete = () => resolve(); tx.onerror = () => resolve(); });
                }
                async updateAllAttendanceWithNewEmployee(newEmp) {
                    const tx = this.db.transaction('attendance', 'readwrite');
                    const store = tx.objectStore('attendance');
                    return new Promise((resolve, reject) => {
                        const req = store.openCursor();
                        req.onsuccess = (e) => {
                            const cursor = e.target.result;
                            if (cursor) {
                                const record = cursor.value;
                                if (record.records && typeof record.records === 'object') {
                                    record.records[newEmp] = '';
                                    cursor.update(record);
                                }
                                cursor.continue();
                            } else {
                                resolve();
                            }
                        };
                        req.onerror = () => reject(req.error);
                    });
                }
                async deleteEmployeeFromAllAttendance(empName) {
                    const tx = this.db.transaction('attendance', 'readwrite');
                    const store = tx.objectStore('attendance');
                    return new Promise((resolve, reject) => {
                        const req = store.openCursor();
                        req.onsuccess = (e) => {
                            const cursor = e.target.result;
                            if (cursor) {
                                const record = cursor.value;
                                if (record.records && typeof record.records === 'object') {
                                    delete record.records[empName];
                                    cursor.update(record);
                                }
                                cursor.continue();
                            } else {
                                resolve();
                            }
                        };
                        req.onerror = () => reject(req.error);
                    });
                }
            }

            // =============================================================
            // 3. APP STATE
            // =============================================================
            const db = new Database();
            let employees = [];
            let attendance = {};
            let salaryPerDay = 50000;
            let currentRole = localStorage.getItem('evo_role') || 'karyawan';

            // DOM refs
            const $ = (s) => document.querySelector(s);
            const $$ = (s) => document.querySelectorAll(s);
            const tableHead = $('#tableHead');
            const tableBody = $('#tableBody');
            const rowCount = $('#rowCount');
            const rekapGrid = $('#rekapGrid');
            const rekapCount = $('#rekapCount');
            const salaryDisplay = $('#salaryDisplay');
            const fileInput = $('#fileInput');
            const resetDataBtn = $('#resetDataBtn');
            const addRowBtn = $('#addRowBtn');
            const editSalaryBtn = $('#editSalaryBtn');
            const exportBtn = $('#exportBtn');
            const addEmployeeBtn = $('#addEmployeeBtn');
            const deleteEmployeeBtn = $('#deleteEmployeeBtn');
            const lastUpdate = $('#lastUpdate');
            const toastContainer = $('#toastContainer');
            const dbStatus = $('#dbStatus');
            const uploadBtn = $('#uploadBtn');
            const uploadWrapper = $('#uploadWrapper');

            // Default data
            const DEFAULT_EMPLOYEES = ['IPUL', 'TOMI', 'ADIT', 'YUGO'];
            const DEFAULT_ATTENDANCE = {
                '2026-07-08': { IPUL: 'HADIR', TOMI: 'HADIR', ADIT: 'HADIR', YUGO: 'ABSEN' },
                '2026-07-09': { IPUL: 'HADIR', TOMI: 'HADIR', ADIT: 'HADIR', YUGO: 'HADIR' },
                '2026-07-10': { IPUL: 'HADIR', TOMI: 'HADIR', ADIT: 'HADIR', YUGO: 'HADIR' },
                '2026-07-11': { IPUL: 'LIBUR', TOMI: 'LIBUR', ADIT: 'LIBUR', YUGO: 'LIBUR' },
                '2026-07-12': { IPUL: 'LIBUR', TOMI: 'LIBUR', ADIT: 'LIBUR', YUGO: 'LIBUR' },
                '2026-07-13': { IPUL: 'HADIR', TOMI: 'HADIR', ADIT: 'ABSEN', YUGO: 'HADIR' },
                '2026-07-14': { IPUL: 'ABSEN', TOMI: 'HADIR', ADIT: 'HADIR', YUGO: 'HADIR' }
            };
            const DEFAULT_SALARY = 50000;

            // =============================================================
            // 4. FUNGSI DATABASE
            // =============================================================
            async function loadAllData() {
                try {
                    await db.open();
                    dbStatus.innerHTML = '<i class="fas fa-database"></i> IndexedDB <span style="color:#4ade80;">●</span>';
                    const settings = await db.getSettings();
                    if (settings) salaryPerDay = settings.salaryPerDay || DEFAULT_SALARY;
                    else { salaryPerDay = DEFAULT_SALARY; await db.saveSettings({ salaryPerDay }); }

                    const empList = await db.getEmployees();
                    if (empList && empList.length > 0) employees = empList;
                    else { employees = DEFAULT_EMPLOYEES; await db.saveEmployees(employees); }

                    const attMap = await db.getAttendance();
                    if (Object.keys(attMap).length > 0) attendance = attMap;
                    else { attendance = JSON.parse(JSON.stringify(DEFAULT_ATTENDANCE)); await db.importAttendance(
                        attendance); }

                    renderAll();
                    showToast('✅ Data dimuat dari IndexedDB', 'success');
                } catch (err) {
                    console.error(err);
                    showToast('Gagal membuka database: ' + err.message, 'error');
                }
            }

            // =============================================================
            // 5. RENDER
            // =============================================================
            function renderAll() {
                renderTable();
                renderRekap();
                rowCount.textContent = Object.keys(attendance).length;
                salaryDisplay.textContent = 'Rp' + salaryPerDay.toLocaleString();
                lastUpdate.textContent = 'Data tersimpan di IndexedDB';
                updateUIByRole();
            }

            function renderTable() {
                const dates = Object.keys(attendance).sort();
                let theadHTML = `<tr><th>Tanggal</th>`;
                employees.forEach(emp => { theadHTML += `<th>${emp}</th>`; });
                theadHTML += `<th style="width:60px;"></th></tr>`;
                tableHead.innerHTML = theadHTML;

                if (dates.length === 0) {
                    tableBody.innerHTML =
                        `<tr><td colspan="${employees.length+2}" class="text-center text-muted" style="padding:30px;">Belum ada data. Upload Excel atau tambah tanggal.</td></tr>`;
                    return;
                }

                let tbodyHTML = '';
                const isAdmin = (currentRole === 'admin');
                dates.forEach(date => {
                    const row = attendance[date] || {};
                    tbodyHTML += `<tr data-date="${date}">`;
                    tbodyHTML += `<td><strong>${formatDate(date)}</strong></td>`;
                    employees.forEach(emp => {
                        const val = row[emp] || '';
                        const statusClass = getStatusClass(val);
                        tbodyHTML += `<td>
                                <select data-date="${date}" data-employee="${emp}" class="status-select" ${!isAdmin ? 'disabled' : ''}>
                                    <option value="" ${val===''?'selected':''}>—</option>
                                    <option value="HADIR" ${val==='HADIR'?'selected':''}>HADIR</option>
                                    <option value="ABSEN" ${val==='ABSEN'?'selected':''}>ABSEN</option>
                                    <option value="LIBUR" ${val==='LIBUR'?'selected':''}>LIBUR</option>
                                </select>
                                <span class="status-badge ${statusClass}">${val || '—'}</span>
                            </td>`;
                    });
                    tbodyHTML += `<td>
                            <button class="btn btn-outline btn-sm delete-row" data-date="${date}" style="color:var(--text-muted); ${!isAdmin ? 'display:none;' : ''}">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>`;
                    tbodyHTML += `</tr>`;
                });
                tableBody.innerHTML = tbodyHTML;

                if (isAdmin) {
                    tableBody.querySelectorAll('.status-select').forEach(sel => {
                        sel.addEventListener('change', async function(e) {
                            const date = this.dataset.date;
                            const emp = this.dataset.employee;
                            const val = this.value;
                            if (!attendance[date]) attendance[date] = {};
                            attendance[date][emp] = val;
                            await db.saveAttendanceRecord(date, attendance[date]);
                            const badge = this.parentElement.querySelector('.status-badge');
                            if (badge) {
                                badge.textContent = val || '—';
                                badge.className = 'status-badge ' + getStatusClass(val);
                            }
                            renderRekap();
                            showToast(`✅ ${date} ${emp} -> ${val || 'kosong'}`, 'success');
                        });
                    });

                    tableBody.querySelectorAll('.delete-row').forEach(btn => {
                        btn.addEventListener('click', async function() {
                            const date = this.dataset.date;
                            if (confirm(`Hapus data tanggal ${formatDate(date)}?`)) {
                                await db.deleteAttendanceRecord(date);
                                delete attendance[date];
                                renderAll();
                                showToast('🗑️ Tanggal dihapus.', 'info');
                            }
                        });
                    });
                }
            }

            function renderRekap() {
                const dates = Object.keys(attendance);
                if (employees.length === 0 || dates.length === 0) {
                    rekapGrid.innerHTML =
                        `<div class="text-muted" style="padding:20px;text-align:center;">Belum ada data karyawan atau absen.</div>`;
                    rekapCount.textContent = '0';
                    return;
                }
                let html = '';
                employees.forEach(emp => {
                    let totalHadir = 0;
                    dates.forEach(date => {
                        const row = attendance[date] || {};
                        if (row[emp] === 'HADIR') totalHadir++;
                    });
                    const gaji = totalHadir * salaryPerDay;
                    html += `
                        <div class="rekap-item">
                            <div class="name">${emp}</div>
                            <div class="hadir">${totalHadir}</div>
                            <div class="gaji">Rp ${gaji.toLocaleString()}</div>
                            <div class="detail">Hadir dari ${dates.length} hari</div>
                        </div>
                    `;
                });
                rekapGrid.innerHTML = html;
                rekapCount.textContent = employees.length;
            }

            function updateUIByRole() {
                const isAdmin = (currentRole === 'admin');
                const editableElements = [
                    { el: fileInput, disable: !isAdmin },
                    { el: uploadBtn, disable: !isAdmin },
                    { el: resetDataBtn, disable: !isAdmin },
                    { el: addRowBtn, disable: !isAdmin },
                    { el: editSalaryBtn, disable: !isAdmin },
                    { el: addEmployeeBtn, disable: !isAdmin },
                    { el: deleteEmployeeBtn, disable: !isAdmin },
                ];
                editableElements.forEach(({ el, disable }) => {
                    if (el) el.disabled = disable;
                });

                document.querySelectorAll('.status-select').forEach(sel => {
                    sel.disabled = !isAdmin;
                });

                document.querySelectorAll('.delete-row').forEach(btn => {
                    btn.style.display = isAdmin ? 'inline-flex' : 'none';
                });

                const fileInputWrapper = uploadWrapper.querySelector('input[type=file]');
                if (fileInputWrapper) {
                    fileInputWrapper.style.display = isAdmin ? 'block' : 'none';
                }
                if (!isAdmin) {
                    uploadBtn.innerHTML = '<i class="fas fa-eye"></i> Hanya Lihat';
                    uploadBtn.style.opacity = '0.6';
                } else {
                    uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload Excel';
                    uploadBtn.style.opacity = '1';
                }
            }

            // =============================================================
            // 6. HELPERS
            // =============================================================
            function formatDate(dateStr) {
                if (!dateStr) return '';
                const parts = dateStr.split('-');
                if (parts.length !== 3) return dateStr;
                const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];
                return `${parseInt(parts[2])} ${months[parseInt(parts[1])-1]} ${parts[0]}`;
            }

            function getStatusClass(val) {
                if (val === 'HADIR') return 'status-hadir';
                if (val === 'ABSEN') return 'status-absen';
                if (val === 'LIBUR') return 'status-libur';
                return 'status-kosong';
            }

            // =============================================================
            // 7. FUNGSI TAMBAH KARYAWAN
            // =============================================================
            async function addEmployee() {
                if (currentRole !== 'admin') { showToast('Hanya admin yang bisa menambah karyawan.', 'error'); return; }
                const name = prompt('Masukkan nama karyawan baru:');
                if (!name) return;
                const trimmed = name.trim().toUpperCase();
                if (!trimmed) { showToast('Nama tidak boleh kosong.', 'error'); return; }
                if (employees.includes(trimmed)) {
                    showToast(`Karyawan ${trimmed} sudah ada.`, 'error');
                    return;
                }
                employees.push(trimmed);
                await db.saveEmployees(employees);

                const dates = Object.keys(attendance);
                for (const date of dates) {
                    attendance[date][trimmed] = '';
                    await db.saveAttendanceRecord(date, attendance[date]);
                }

                renderAll();
                showToast(`✅ Karyawan ${trimmed} berhasil ditambahkan.`, 'success');
            }

            // =============================================================
            // 8. FUNGSI HAPUS KARYAWAN
            // =============================================================
            async function deleteEmployee() {
                if (currentRole !== 'admin') { showToast('Hanya admin yang bisa menghapus karyawan.', 'error'); return; }
                if (employees.length === 0) {
                    showToast('Tidak ada karyawan untuk dihapus.', 'error');
                    return;
                }
                const name = prompt('Masukkan nama karyawan yang akan dihapus:\n' + employees.join(', '));
                if (!name) return;
                const trimmed = name.trim().toUpperCase();
                if (!trimmed) { showToast('Nama tidak boleh kosong.', 'error'); return; }
                if (!employees.includes(trimmed)) {
                    showToast(`Karyawan ${trimmed} tidak ditemukan.`, 'error');
                    return;
                }
                if (!confirm(`Yakin ingin menghapus karyawan ${trimmed} dan semua data absennya?`)) return;

                // Hapus dari employees
                employees = employees.filter(e => e !== trimmed);
                await db.saveEmployees(employees);

                // Hapus dari semua attendance record
                for (const date of Object.keys(attendance)) {
                    delete attendance[date][trimmed];
                    await db.saveAttendanceRecord(date, attendance[date]);
                }

                renderAll();
                showToast(`🗑️ Karyawan ${trimmed} berhasil dihapus.`, 'success');
            }

            // =============================================================
            // 9. FUNGSI TAMBAH TANGGAL (HARI BERIKUTNYA)
            // =============================================================
            async function addDateRow() {
                if (currentRole !== 'admin') { showToast('Hanya admin yang bisa menambah tanggal.', 'error'); return; }
                const dates = Object.keys(attendance).sort();
                let newDateStr;
                if (dates.length === 0) {
                    newDateStr = new Date().toISOString().slice(0, 10);
                } else {
                    const lastDate = dates[dates.length - 1];
                    const d = new Date(lastDate);
                    d.setDate(d.getDate() + 1);
                    newDateStr = d.toISOString().slice(0, 10);
                }
                if (attendance[newDateStr]) {
                    showToast(`Tanggal ${formatDate(newDateStr)} sudah ada.`, 'error');
                    return;
                }
                const record = {};
                employees.forEach(emp => { record[emp] = ''; });
                attendance[newDateStr] = record;
                await db.saveAttendanceRecord(newDateStr, record);
                renderAll();
                showToast(`📅 Tanggal ${formatDate(newDateStr)} ditambahkan.`, 'success');
            }

            async function editSalary() {
                if (currentRole !== 'admin') { showToast('Hanya admin yang bisa mengubah gaji.', 'error'); return; }
                const input = prompt('Masukkan gaji per hari (Rupiah):', salaryPerDay);
                if (input === null) return;
                const val = parseFloat(input);
                if (isNaN(val) || val < 0) { showToast('Masukkan angka valid.', 'error'); return; }
                salaryPerDay = val;
                await db.saveSettings({ salaryPerDay });
                renderAll();
                showToast('💰 Gaji per hari diperbarui.', 'success');
            }

            async function resetToDefault() {
                if (currentRole !== 'admin') { showToast('Hanya admin yang bisa reset data.', 'error'); return; }
                if (!confirm('Reset semua data ke contoh awal?')) return;
                employees = DEFAULT_EMPLOYEES;
                attendance = JSON.parse(JSON.stringify(DEFAULT_ATTENDANCE));
                salaryPerDay = DEFAULT_SALARY;
                await db.saveEmployees(employees);
                await db.importAttendance(attendance);
                await db.saveSettings({ salaryPerDay });
                renderAll();
                showToast('🔄 Data direset ke contoh.', 'info');
            }

            async function importExcelData(file) {
                if (currentRole !== 'admin') { showToast('Hanya admin yang bisa import Excel.', 'error'); return; }
                const reader = new FileReader();
                reader.onload = async function(e) {
                    try {
                        const workbook = XLSX.read(e.target.result, { type: 'array' });
                        const sheet = workbook.Sheets[workbook.SheetNames[0]];
                        const json = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '' });
                        if (json.length < 2) { showToast('File kosong.', 'error'); return; }

                        const header = json[0];
                        let dateColIdx = -1;
                        let empCols = [];
                        let empNames = [];
                        for (let i = 0; i < header.length; i++) {
                            const col = String(header[i]).toUpperCase().trim();
                            if (col === 'TANGGAL') dateColIdx = i;
                            else if (col === 'IPUL' || col === 'TOMI' || col === 'ADIT' || col === 'YUGO') {
                                empCols.push(i);
                                empNames.push(col);
                            }
                        }
                        if (dateColIdx === -1 || empCols.length === 0) {
                            showToast('Format Excel tidak cocok.', 'error');
                            return;
                        }

                        let newAtt = {};
                        let newSalary = 50000;
                        for (let r = 1; r < json.length; r++) {
                            const row = json[r];
                            if (!row || row.length === 0) continue;
                            const firstCell = String(row[0] || '').toUpperCase().trim();
                            if (firstCell === 'GAJI PER HARI') {
                                for (let c = 1; c < row.length; c++) {
                                    const v = parseFloat(row[c]);
                                    if (!isNaN(v) && v > 0) { newSalary = v; break; }
                                }
                                continue;
                            }
                            const dateVal = row[dateColIdx];
                            if (!dateVal) continue;
                            let dateStr = '';
                            if (typeof dateVal === 'number') {
                                const d = new Date((dateVal - 25569) * 86400 * 1000);
                                dateStr = d.toISOString().slice(0, 10);
                            } else if (typeof dateVal === 'string') {
                                const d = new Date(dateVal);
                                if (!isNaN(d)) dateStr = d.toISOString().slice(0, 10);
                                else dateStr = dateVal.slice(0, 10);
                            }
                            if (!dateStr) continue;
                            const record = {};
                            empCols.forEach((idx, i) => {
                                const val = String(row[idx] || '').toUpperCase().trim();
                                if (['HADIR', 'ABSEN', 'LIBUR'].includes(val)) {
                                    record[empNames[i]] = val;
                                } else {
                                    record[empNames[i]] = '';
                                }
                            });
                            if (Object.values(record).some(v => v !== '')) {
                                newAtt[dateStr] = record;
                            }
                        }

                        employees = empNames;
                        salaryPerDay = newSalary;
                        attendance = newAtt;
                        await db.saveEmployees(employees);
                        await db.importAttendance(attendance);
                        await db.saveSettings({ salaryPerDay });
                        renderAll();
                        showToast('✅ Data berhasil diimpor!', 'success');
                    } catch (err) {
                        showToast('Gagal baca file: ' + err.message, 'error');
                    }
                };
                reader.readAsArrayBuffer(file);
            }

            // =============================================================
            // 10. EXPORT EXCEL (PEMBUKUAN)
            // =============================================================
            function exportToExcel() {
                if (Object.keys(attendance).length === 0) {
                    showToast('Tidak ada data untuk diekspor.', 'error');
                    return;
                }
                const wb = XLSX.utils.book_new();

                const dates = Object.keys(attendance).sort();
                const rows = [];
                const header = ['TANGGAL', ...employees];
                rows.push(header);
                dates.forEach(date => {
                    const row = [date];
                    employees.forEach(emp => {
                        row.push(attendance[date][emp] || '');
                    });
                    rows.push(row);
                });
                rows.push([]);
                const totalRow = ['TOTAL HADIR'];
                employees.forEach(emp => {
                    let total = 0;
                    dates.forEach(date => {
                        if (attendance[date][emp] === 'HADIR') total++;
                    });
                    totalRow.push(total);
                });
                rows.push(totalRow);
                const gajiRow = ['GAJI'];
                employees.forEach(emp => {
                    let total = 0;
                    dates.forEach(date => {
                        if (attendance[date][emp] === 'HADIR') total++;
                    });
                    gajiRow.push(total * salaryPerDay);
                });
                rows.push(gajiRow);
                rows.push(['GAJI PER HARI', salaryPerDay]);

                const ws = XLSX.utils.aoa_to_sheet(rows);
                XLSX.utils.book_append_sheet(wb, ws, 'Absen');

                const rekapRows = [
                    ['Nama', 'Total Hadir', 'Gaji']
                ];
                employees.forEach(emp => {
                    let total = 0;
                    dates.forEach(date => {
                        if (attendance[date][emp] === 'HADIR') total++;
                    });
                    rekapRows.push([emp, total, total * salaryPerDay]);
                });
                const wsRekap = XLSX.utils.aoa_to_sheet(rekapRows);
                XLSX.utils.book_append_sheet(wb, wsRekap, 'Rekap');

                const fileName = `Absen_EVO_${new Date().toISOString().slice(0,10)}.xlsx`;
                XLSX.writeFile(wb, fileName);
                showToast('📥 Export Excel berhasil!', 'success');
            }

            // =============================================================
            // 11. TOAST
            // =============================================================
            function showToast(message, type = 'info') {
                const icons = { success: 'fa-check-circle', error: 'fa-exclamation-circle', info: 'fa-info-circle' };
                const icon = icons[type] || icons.info;
                const el = document.createElement('div');
                el.className = `toast ${type}`;
                el.innerHTML = `<i class="fas ${icon}"></i> ${message}`;
                toastContainer.appendChild(el);
                setTimeout(() => {
                    el.classList.add('hide');
                    setTimeout(() => el.remove(), 350);
                }, 3500);
            }
            window.showToast = showToast;

            // =============================================================
            // 12. INIT APP
            // =============================================================
            async function initApp() {
                await loadAllData();

                fileInput.addEventListener('change', function(e) {
                    if (this.files && this.files.length > 0) {
                        importExcelData(this.files[0]);
                        this.value = '';
                    }
                });
                resetDataBtn.addEventListener('click', resetToDefault);
                addRowBtn.addEventListener('click', addDateRow);
                editSalaryBtn.addEventListener('click', editSalary);
                exportBtn.addEventListener('click', exportToExcel);
                addEmployeeBtn.addEventListener('click', addEmployee);
                deleteEmployeeBtn.addEventListener('click', deleteEmployee);

                document.addEventListener('keydown', (e) => {
                    if (e.ctrlKey && e.shiftKey && e.key === 'A') {
                        e.preventDefault();
                        addDateRow();
                    }
                });
            }

            // =============================================================
            // 13. START
            // =============================================================
            checkAuth();
            window.initApp = initApp;

        })();
    </script>

